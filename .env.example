# ========================================
# AI Agent 每日新闻推送 — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ⚠️ .env 文件绝不能提交到 Git！
# ========================================

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# WxPusher 推送配置
# AppToken：在 WxPusher 后台「应用管理」中查看，以 AT_ 开头
WXPUSHER_APP_TOKEN=AT_xxxxxxxxxxxxxxxxxxxxx
# UID：在 WxPusher 后台「用户管理」中查看，以 UID_ 开头（不是 AT_ 开头！）
WXPUSHER_UID=UID_xxxxxxxxxxxxxxxxxxxxx
