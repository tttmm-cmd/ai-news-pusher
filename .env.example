# ========================================
# AI Agent 每日新闻推送 — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ⚠️ .env 文件绝不能提交到 Git！
# ========================================

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 邮件推送配置（默认适配 QQ 邮箱）
# SMTP 服务器：默认 smtp.qq.com，一般不用改
SMTP_HOST=smtp.qq.com
# 端口：465=SSL（推荐），587=STARTTLS
SMTP_PORT=465
# 发件邮箱：你的 QQ 邮箱地址
SMTP_USER=yourname@qq.com
# 授权码：QQ 邮箱「设置 → 账户 → 开启 SMTP 服务」后生成，不是登录密码！
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# 收件人：默认发给自己，可改成别的邮箱
MAIL_TO=yourname@qq.com
